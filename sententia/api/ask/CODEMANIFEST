Imports:
  - Types:
      - RESTResource
    From: sententia/endpoints
  - Types:
      - Index
    From: sententia/index
  - Types:
      - OpenaiProvider
      - AnthropicProvider
    Usages:
      - llm_generating
    From: sententia/llm
  - Usages:
      - asking
    From: sententia/rag

Usages:
  conventions: .goga/usages/conventions.md
  pydantic: .goga/usages/cooks/pydantic.md
  hexagonal: .goga/usages/cooks/hexagonal.md

Annotations: |
  Apply `conventions` for code and test writing standards.

  The POST /ask adapter is responsible for generating answers via RAG.
  Apply `pydantic` to define request and response data models.
  Apply `hexagonal` to clarify the adapter role within the architecture.
  Apply `asking` to execute the RAG pipeline.
  Apply `llm_generating` for LLM provider integration patterns.

---

"AskRequest()":
  location: models.py
  annotations: |
    Request model for the POST /ask endpoint.
    Implement using `pydantic`.
  properties:
    query -> str: |
      The user's question text. Defaults to an empty string.
    top -> int | None: |
      Number of context chunks. Falls back to AskResource default when omitted.
      Defaults to None.

"AskResponse()":
  location: models.py
  annotations: |
    Response model for the POST /ask endpoint.
    Implement using `pydantic`.
  properties:
    answer -> str: |
      Generated answer. Defaults to an empty string.
    sources -> list: |
      List of source files. Defaults to an empty list.

"RESTResource::AskResource(index: Index, llm_provider: OpenaiProvider | AnthropicProvider, top: int = 10)":
  location: ask.py
  annotations: |
    REST resource for the POST /ask endpoint. Generates RAG-based answers.

    `index`: an `Index` instance.
    `llm_provider`: a configured LLM provider (`OpenaiProvider` or `AnthropicProvider`).
    `top`: number of context chunks. Defaults to 10.

    Apply `asking` to execute the RAG pipeline.
    Apply `pydantic` for data conversion.
    Apply `hexagonal` to understand the adapter architectural role.
  properties:
    url_rule -> str: |
      "/ask"
  methods:
    "post(request: AskRequest) -> response:AskResponse": |
      Handle POST /ask requests.

      `request`: pydantic request model with query and top fields.
      `response`: pydantic response model with answer and sources fields.

      Pass request.top to the RAG pipeline when not None; otherwise fall back to the constructor default.

      Apply `asking` to execute the RAG pipeline.
      Apply `pydantic` for data conversion.

