Imports:
  - Types:
      - RESTResource
    From: sententia/endpoints
  - Types:
      - Storage
    Usages:
      - reading
    From: sententia/storage

Usages:
  conventions: .goga/usages/conventions.md
  pydantic: .goga/usages/cooks/pydantic.md
  hexagonal: .goga/usages/cooks/hexagonal.md

Annotations: |
  GET /files/<path> adapter — retrieves file contents.

  Apply `conventions` for coding and testing standards.
  Apply `pydantic` to define request and response data models.
  Apply `hexagonal` to clarify the adapter role within the architecture.
  Apply `reading` for file read operations.

---

"FileResponse()":
  location: models.py
  annotations: |
    Response model for GET /files/<path>.
    Apply `pydantic` practice for model implementation.
  properties:
    text -> str: |
      File content string. Default value: empty string.
    source -> str: |
      File path string. Default value: empty string.

"RESTResource::FilesResource(storage: Storage)":
  location: files.py
  annotations: |
    REST adapter serving GET /files/<path> — retrieves and returns file contents.

    `storage`: an instance of `Storage` used for file read operations.

    Apply `reading` for reading files through `storage`.
    Apply `pydantic` for constructing response models.
    Apply `hexagonal` for adapter boundaries and responsibilities.
  properties:
    url_rule -> str: |
      "/files/{path:path}"
  methods:
    "get(path: str) -> response:FileResponse": |
      Handle GET /files/<path> requests.

      `path`: relative file path extracted from the URL.
      `response`: a pydantic response model populated with text and source fields.

      Return HTTP 404 when the file is not found.

      Apply `reading` for reading file contents.
      Apply `pydantic` for constructing the response model.

