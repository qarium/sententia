Imports:
  - Types:
      - RESTResource
    From: sententia/endpoints
  - Types:
      - Storage
    Usages:
      - reading
    From: sententia/storage

Usages:
  conventions: .goga/usages/conventions.md
  pydantic: .goga/usages/cooks/pydantic.md
  hexagonal: .goga/usages/cooks/hexagonal.md

Annotations: |
  Reference `conventions` for code and test authoring rules.

  GET /files/<path> adapter — retrieves file contents.
  Reference `pydantic` practice for response model definitions.
  Reference `hexagonal` practice to understand adapter boundaries.
  Reference `reading` practice for file read operations.

---

"FileResponse()":
  location: models.py
  annotations: |
    Response model for GET /files/<path>.
    Reference `pydantic` practice for model implementation.
  properties:
    text -> str: |
      File content string. Default value: empty string.
    source -> str: |
      File path string. Default value: empty string.

"RESTResource::FilesResource(storage: Storage)":
  location: files.py
  annotations: |
    REST adapter serving GET /files/<path> — retrieves and returns file contents.

    `storage`: an instance of `Storage` used for file read operations.

    Reference `reading` practice when reading files through `storage`.
    Reference `pydantic` practice when constructing response models.
    Reference `hexagonal` practice to understand adapter boundaries and responsibilities.
  properties:
    url_rule -> str: |
      "/files/{path:path}"
  methods:
    "get(path: str) -> response:FileResponse": |
      Handle GET /files/<path> requests.

      `path`: relative file path extracted from the URL.
      `response`: a pydantic response model populated with text and source fields.

      Return HTTP 404 when the file is not found.
      Reference `reading` practice when reading file contents.
      Reference `pydantic` practice when constructing the response model.

