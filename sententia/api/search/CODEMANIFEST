Imports:
  - Types:
      - RESTResource
    From: sententia/endpoints
  - Types:
      - Index
    Usages:
      - searching
    From: sententia/index

Usages:
  conventions: .goga/usages/conventions.md
  pydantic: .goga/usages/cooks/pydantic.md
  hexagonal: .goga/usages/cooks/hexagonal.md

Annotations: |
  Adapter for POST /search — retrieves relevant documents.

  Apply `conventions` for coding and testing standards.
  Apply `pydantic` to define request and response data models.
  Apply `hexagonal` to clarify the adapter role within the architecture.
  Apply `searching` to perform search and interpret result format.

---

"SearchRequest()":
  location: models.py
  annotations: |
    Request model for POST /search endpoint.
    Implement using `pydantic`.
  properties:
    query -> str: |
      Search query text. Defaults to an empty string.
    top -> int: |
      Maximum number of results to return. Defaults to 10.

"SearchResultItem()":
  location: models.py
  annotations: |
    Single search result item model.
    Implement using `pydantic`.
  properties:
    text -> str: |
      Document text fragment. Defaults to an empty string.
    source -> str: |
      Source file path. Defaults to an empty string.
    score -> float: |
      Relevance score. Defaults to 0.0.

"SearchResponse()":
  location: models.py
  annotations: |
    Response model for POST /search endpoint.
    Implement using `pydantic`.
  properties:
    results -> list: |
      List of `SearchResultItem`. Defaults to an empty list.

"RESTResource::SearchResource(index: Index)":
  location: search.py
  annotations: |
    REST resource for POST /search — retrieves relevant documents.

    `index`: an `Index` instance.

    Apply `searching` to perform search and interpret result format.
    Apply `pydantic` for data conversion.
    Apply `hexagonal` to understand the adapter's architectural role.
  properties:
    url_rule -> str: |
      "/search"
  methods:
    "post(request: SearchRequest) -> response:SearchResponse": |
      Handle POST /search requests.

      `request`: pydantic request model with query and top fields.
      `response`: pydantic response model containing the result list.

      Apply `searching` to execute search.
      Apply `pydantic` for data conversion.

