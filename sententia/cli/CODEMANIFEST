"ParseCliResult()":
  location: cli.py
  annotations: |
    Data model representing the parsed CLI arguments.
    Holds all parsed values and the env file path.

    Apply `conventions` for coding and testing standards.
  properties:
    "data_dir -> str": |
      Path to the Markdown files directory.
    "env_file -> str | None": |
      Path to the env file. When None, the system uses the default value.
    "index_path -> str | None": |
      Path to the FAISS index file. When None, the system keeps the index in memory.
    "llm_protocol -> str": |
      LLM provider type: "openai", "anthropic", or "ollama".
    "llm_url -> str": |
      LLM provider API endpoint URL.
    "llm_model -> str": |
      LLM model identifier.
    "llm_token -> str | None": |
      API key. When None, the system reads the key from ENV or the env file.
    "mcp -> bool | None": |
      MCP Server mode flag. When None, the system falls back to the config value.
    "host -> str | None": |
      Server bind address. When None, the system falls back to the config value.
    "port -> int | None": |
      Server port. When None, the system falls back to the config value.

"parse_cli_args(argv: list[str] | None = None) -> result:ParseCliResult":
  location: cli.py
  annotations: |
    Parse CLI arguments into a structured result.

    `argv`: argument list. When None, the function reads sys.argv.

    Positional arguments:
      data_dir — path to the Markdown files directory

    Options:
      --env-file — path to the env configuration file
      --index-path — path to the FAISS index file
      --llm-protocol — LLM provider type (openai, anthropic, ollama). Required.
      --llm-url — LLM API endpoint URL. Required.
      --llm-model — model identifier. Required.
      --llm-token — API key
      --mcp — enable MCP Server mode
      --host — server bind address
      --port — server port

    Apply `conventions` for coding and testing standards.

