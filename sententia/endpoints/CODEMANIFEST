Usages:
  conventions: .goga/usages/conventions.md

Annotations: |
  Base endpoint interfaces.

  `RESTResource` defines the REST resource contract with get/post/put/delete methods.
  `MCPTool` defines the MCP tool contract.

  Apply `conventions` for coding and testing standards.

---

"RESTResource()":
  location: rest.py
  annotations: |
    Abstract base class for REST resources. Defines the HTTP handler contract.
    Specialized by concrete resource implementations.

    Requirements:
    - All methods default to raising NotImplementedError("Method Not Allowed")
    - Property url_rule is abstract — the specializing resource must define it
    - The specializing resource overrides only the HTTP methods it supports with concrete parameters
  properties:
    url_rule -> str: |
      Abstract property. URL route pattern.
      The specializing resource must define this property with a concrete value.
  methods:
    "get() -> response:Any": |
      Handles HTTP GET requests. Default raises NotImplementedError("Method Not Allowed").
      The specializing resource overrides with concrete parameters and return type.
      Argument signature is determined by the specializing type.
    "post() -> response:Any": |
      Handles HTTP POST requests. Default raises NotImplementedError("Method Not Allowed").
      The specializing resource overrides with concrete parameters and return type.
      Argument signature is determined by the specializing type.
    "put() -> response:Any": |
      Handles HTTP PUT requests. Default raises NotImplementedError("Method Not Allowed").
      The specializing resource overrides with concrete parameters and return type.
      Argument signature is determined by the specializing type.
    "delete() -> response:Any": |
      Handles HTTP DELETE requests. Default raises NotImplementedError("Method Not Allowed").
      The specializing resource overrides with concrete parameters and return type.
      Argument signature is determined by the specializing type.

"MCPTool()":
  location: mcp.py
  annotations: |
    Abstract base class for MCP tools. Defines the contract for external MCP clients.
    Specialized by concrete tool implementations.

    Requirements:
    - Properties name and description are abstract — the specializing tool must define them
    - Method execute is abstract — the specializing tool must override it with concrete parameters
  properties:
    name -> str: |
      Abstract property. Tool name for MCP server registration.
      The specializing tool must define this property with a concrete value.
    description -> str: |
      Abstract property. Human-readable tool description for MCP clients.
      The specializing tool must define this property with a concrete value.
  methods:
    "execute() -> result:Any": |
      Executes the tool. Default raises NotImplementedError.
      The specializing tool overrides with concrete parameters and return type.
      Argument signature and return type are determined by the specializing type.

---

