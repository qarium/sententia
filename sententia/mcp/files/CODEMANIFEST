Imports:
  - Types:
      - MCPTool
    From: sententia/endpoints
  - Types:
      - Storage
    Usages:
      - reading
    From: sententia/storage

Usages:
  conventions: .goga/usages/conventions.md
  pydantic: .goga/usages/cooks/pydantic.md
  hexagonal: .goga/usages/cooks/hexagonal.md

Annotations: |
  Use `conventions` for coding and testing rules.

  MCP tool for reading file content.
  Use the `hexagonal` practice to understand the adapter role.
  Use the `reading` practice for file reading operations.

---

"FilesToolResult()":
  location: models.py
  annotations: |
    Result model for the files MCP tool.
    Use `pydantic` for implementation (conventions: kw_only=True, defaults).
  properties:
    text -> str: |
      The file content. Defaults to an empty string.
    source -> str: |
      The file path. Defaults to an empty string.

"MCPTool::FilesTool(storage: Storage)":
  location: files.py
  annotations: |
    MCP tool for reading file content.

    `storage`: A `Storage` instance used for file reading.

    Use the `reading` practice for file reading operations.
    Use the `hexagonal` practice to understand the adapter role.
  properties:
    name -> str: |
      "files"
    description -> str: |
      "Read file content by path"
  methods:
    "execute(path: str) -> result:FilesToolResult": |
      Read file content.

      `path`: A relative path to the target file.
      `result`: A `FilesToolResult` containing text and source fields.

      If the file is not found, return a tool error.
      Use the `reading` practice for file reading operations.

---

