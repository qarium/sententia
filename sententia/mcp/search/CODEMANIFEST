Imports:
  - Types:
      - MCPTool
    From: sententia/endpoints
  - Types:
      - Index
    Usages:
      - searching
    From: sententia/index

Usages:
  conventions: .goga/usages/conventions.md
  pydantic: .goga/usages/cooks/pydantic.md
  hexagonal: .goga/usages/cooks/hexagonal.md

Annotations: |
  MCP tool providing semantic search over the knowledge base.

  Apply `conventions` for coding and testing standards.
  Apply the `hexagonal` practice to understand the adapter role.
  Apply the `searching` practice to perform search and interpret result format.

---

"SearchToolResult()":
  location: models.py
  annotations: |
    Search result DTO for the MCP tool.
    Implement using `pydantic` (conventions: kw_only=True, defaults).
  properties:
    text -> str: |
      Text fragment content. Defaults to empty string.
    source -> str: |
      File path. Defaults to empty string.
    score -> float: |
      Relevance score. Defaults to 0.0.

"MCPTool::SearchTool(index: Index)":
  location: search.py
  annotations: |
    MCP tool adapter for semantic search.

    `index`: an `Index` instance.

    Apply the `searching` practice for search operations.
  properties:
    name -> str: |
      "search"
    description -> str: |
      "Search for relevant documents in the knowledge base"
  methods:
    "execute(query: str, top: int = 10) -> results:list[SearchToolResult]": |
      Execute semantic search and return relevant fragments.

      `query`: the search query text.
      `top`: the maximum number of results to return.

      `results`: a list of `SearchToolResult` entries sorted by descending score.

      Apply the `searching` practice to execute search.

